---
/**
 * A fleet of devices as dots.
 *  mode="rollout": a new model version reaches a small canary group, then
 *  wider waves; `bad` dots fail their health check and roll back.
 *  mode="wake": nodes wake one by one, as a scheduler might choose them.
 * Order is pseudo-random but fixed, so the pattern looks scattered and
 * renders the same every build.
 */
interface Props {
  count?: number;
  mode?: 'rollout' | 'wake';
  bad?: number;
  label: string;
  cols?: number;
}
const { count = 60, mode = 'rollout', bad = 1, label, cols = 12 } = Astro.props;

// Deterministic shuffle (LCG) so the waves don't sweep left to right.
let seed = 7;
const rand = () => ((seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648);
const order = Array.from({ length: count }, (_, i) => i).sort(() => rand() - 0.5);
const rank = new Array(count);
order.forEach((dot, r) => (rank[dot] = r));

const canary = Math.max(2, Math.round(count * 0.05));
const second = Math.round(count * 0.3);
const dots = Array.from({ length: count }, (_, i) => {
  const r = rank[i];
  if (mode === 'wake') return { d: (r / count) * 6, bad: false };
  const wave = r < canary ? 0 : r < canary + second ? 1 : 2;
  const isBad = wave === 1 && r < canary + bad;
  return { d: wave * 1.4 + (r % 5) * 0.06, bad: isBad };
});
---

<div class="pk-fleet" data-mode={mode} role="img" aria-label={label} style={`--cols: ${cols}`}>
  {dots.map((dot) => <i class={dot.bad ? 'pk-bad' : undefined} style={`--d: ${dot.d.toFixed(2)}`} />)}
</div>
