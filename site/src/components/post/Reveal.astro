---
/**
 * Fades its content up as it scrolls into view. Give siblings increasing
 * `i` (0, 1, 2...) to stagger them.
 */
interface Props {
  i?: number;
  as?: string;
  class?: string;
}
const { i = 0, as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['pk-reveal', className]} style={`--pk-i: ${i}`}><slot /></Tag>
