---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TableOfContents from '../../components/TableOfContents.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  const publications = await getCollection('publications', ({ data }) => !data.draft);
  const pubById = Object.fromEntries(publications.map((p) => [p.id, p]));
  return projects.map((project) => ({
    params: { slug: project.id },
    props: {
      project,
      relatedPub: project.data.relatedPublication ? pubById[project.data.relatedPublication] ?? null : null,
    },
  }));
}

const { project, relatedPub } = Astro.props;
const { Content, headings } = await render(project);
const { data } = project;

const pageUrl = new URL(`/projects/${project.id}/`, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: data.title,
      description: data.oneLiner,
      url: pageUrl,
      ...(data.heroImage && { image: new URL(data.heroImage, Astro.site).toString() }),
      author: {
        '@type': 'Person',
        '@id': 'https://samiulmakes.com/#person',
        name: 'Samiul Hoque',
        url: 'https://samiulmakes.com',
        alternateName: 'samiulmakes',
      },
      publisher: { '@id': 'https://samiulmakes.com/#person' },
      ...(data.year && { datePublished: `${data.year}` }),
      keywords: data.tags.join(', '),
      isPartOf: { '@id': 'https://samiulmakes.com/#website' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Samiul Hoque', item: 'https://samiulmakes.com/' },
        { '@type': 'ListItem', position: 2, name: 'Projects', item: 'https://samiulmakes.com/projects/' },
        { '@type': 'ListItem', position: 3, name: data.title, item: pageUrl },
      ],
    },
  ],
};
---

<Base title={data.title} description={data.oneLiner} ogImage={data.heroImage} jsonLd={jsonLd}>
  <article class="container project" data-slug={project.id}>
    <header>
      <a href="/projects/" class="back">← All projects</a>
      <span class="eyebrow">{data.category}{data.year ? ` · ${data.year}` : ''}</span>
      <h1>{data.title}</h1>
      <p class="one-liner">{data.oneLiner}</p>
      <dl class="meta-grid">
        {data.role && (
          <>
            <dt>Role</dt>
            <dd>{data.role}</dd>
          </>
        )}
        {data.client && (
          <>
            <dt>Context</dt>
            <dd>{data.client}</dd>
          </>
        )}
        {data.tags.length > 0 && (
          <>
            <dt>Tags</dt>
            <dd class="tags">
              {data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </dd>
          </>
        )}
      </dl>
    </header>

    <div class="body-with-toc">
      <div class="body" data-gallery={JSON.stringify(data.gallery)}>
        {data.heroImage && (
          <figure class="hero">
            <img src={data.heroImage} alt={data.title} loading="eager" />
          </figure>
        )}
        <Content />
      </div>
      <aside class="toc-sidebar">
        <TableOfContents headings={headings} />
      </aside>
    </div>

    {relatedPub && (
      <aside class="related-pub">
        <span class="rp-label">Published as</span>
        <p class="rp-title">
          <a href={relatedPub.data.url ?? `https://doi.org/${relatedPub.data.doi}`} target="_blank" rel="noopener">
            {relatedPub.data.title}
          </a>
        </p>
        <p class="rp-meta">
          {relatedPub.data.authors.join(', ')}
          <br />
          <em>{relatedPub.data.venue}</em>
          {relatedPub.data.location && <>, {relatedPub.data.location}</>}
          , {relatedPub.data.year}.
          {relatedPub.data.doi && <> doi:{relatedPub.data.doi}</>}
        </p>
        <p class="rp-link">
          <a href="/publications/">All publications →</a>
        </p>
      </aside>
    )}

    {data.press.length > 0 && (
      <section class="press">
        <h2>In the press</h2>
        <ul>
          {data.press.map((item) => (
            <li>
              <span class="press-outlet">
                {item.outlet}
                {item.lang === 'bn' && <span class="press-lang">বাংলা</span>}
              </span>
              <div class="press-body">
                <a href={item.url} target="_blank" rel="noopener">{item.title}</a>
                {item.date && <span class="press-date">{item.date}</span>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    {data.externalLinks.length > 0 && (
      <section class="links">
        <h2>Links</h2>
        <ul>
          {data.externalLinks.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>

<script>
  function interleaveGallery() {
    const body = document.querySelector<HTMLElement>('.body[data-gallery]');
    if (!body) return;

    const gallery: string[] = JSON.parse(body.dataset.gallery || '[]');
    if (!gallery.length) return;

    const h2s = Array.from(body.querySelectorAll(':scope > h2'));
    if (h2s.length < 2) {
      appendRemainder(body, gallery, 0);
      return;
    }

    const breaks = h2s.slice(1);
    const perBreak = Math.max(1, Math.ceil(gallery.length / breaks.length));
    let idx = 0;

    for (const h2 of breaks) {
      if (idx >= gallery.length) break;
      const count = Math.min(perBreak, gallery.length - idx);
      const figure = document.createElement('figure');
      figure.className = 'section-images' + (count === 1 ? ' single' : '');
      for (let i = 0; i < count; i++) {
        const a = document.createElement('a');
        a.href = gallery[idx];
        a.target = '_blank';
        a.rel = 'noopener';
        const img = document.createElement('img');
        img.src = gallery[idx];
        img.alt = '';
        img.loading = 'lazy';
        a.appendChild(img);
        figure.appendChild(a);
        idx++;
      }
      body.insertBefore(figure, h2);
    }

    appendRemainder(body, gallery, idx);
  }

  function appendRemainder(body: HTMLElement, gallery: string[], fromIdx: number) {
    if (fromIdx >= gallery.length) return;
    const figure = document.createElement('figure');
    figure.className = 'section-images remainder';
    for (let i = fromIdx; i < gallery.length; i++) {
      const a = document.createElement('a');
      a.href = gallery[i];
      a.target = '_blank';
      a.rel = 'noopener';
      const img = document.createElement('img');
      img.src = gallery[i];
      img.alt = '';
      img.loading = 'lazy';
      a.appendChild(img);
      figure.appendChild(a);
    }
    body.appendChild(figure);
  }

  /* ------------------------------------------------------------------ *
   * Lightbox — click any body image to open it full-screen.
   * Arrow keys / swipe to move through the page's images, Esc to close.
   * No dependencies; re-initialises cleanly after a view transition.
   * ------------------------------------------------------------------ */
  let lbItems: { src: string; caption: string }[] = [];
  let lbIndex = 0;
  let lbEl: HTMLElement | null = null;

  function captionFor(img: HTMLImageElement): string {
    const cap = img.closest('figure')?.querySelector('figcaption');
    if (!cap) return img.alt || '';
    // Drop link text ("Full sheet as PDF ↗") — the links aren't clickable
    // inside the overlay, so their labels only clutter the caption.
    const clone = cap.cloneNode(true) as HTMLElement;
    clone.querySelectorAll('a').forEach((a) => a.remove());
    return clone.textContent?.replace(/\s+/g, ' ').trim() || img.alt || '';
  }

  function buildLightbox(): HTMLElement {
    const el = document.createElement('div');
    el.className = 'lightbox';
    el.setAttribute('role', 'dialog');
    el.setAttribute('aria-modal', 'true');
    el.setAttribute('aria-label', 'Image viewer');
    el.innerHTML = `
      <button class="lb-close" aria-label="Close">&times;</button>
      <button class="lb-prev" aria-label="Previous image">&#8249;</button>
      <button class="lb-next" aria-label="Next image">&#8250;</button>
      <figure class="lb-stage">
        <img alt="" />
        <figcaption></figcaption>
      </figure>
      <span class="lb-count"></span>`;

    el.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('.lb-prev')) { step(-1); return; }
      if (t.closest('.lb-next')) { step(1); return; }
      // clicking the backdrop (anything that isn't the image itself) closes
      if (!t.closest('.lb-stage img')) closeLightbox();
    });

    let touchX = 0;
    el.addEventListener('touchstart', (e) => { touchX = e.changedTouches[0].clientX; }, { passive: true });
    el.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
    }, { passive: true });

    document.body.appendChild(el);
    return el;
  }

  function render() {
    if (!lbEl) return;
    const item = lbItems[lbIndex];
    const img = lbEl.querySelector<HTMLImageElement>('.lb-stage img')!;
    const cap = lbEl.querySelector<HTMLElement>('.lb-stage figcaption')!;
    const count = lbEl.querySelector<HTMLElement>('.lb-count')!;
    img.src = item.src;
    img.alt = item.caption;
    cap.textContent = item.caption;
    cap.hidden = !item.caption;
    count.textContent = lbItems.length > 1 ? `${lbIndex + 1} / ${lbItems.length}` : '';
    lbEl.classList.toggle('single', lbItems.length < 2);
  }

  function step(delta: number) {
    if (lbItems.length < 2) return;
    lbIndex = (lbIndex + delta + lbItems.length) % lbItems.length;
    render();
  }

  function openLightbox(index: number) {
    if (!lbEl) lbEl = buildLightbox();
    lbIndex = index;
    render();
    lbEl.classList.add('open');
    document.body.classList.add('lb-locked');
    lbEl.querySelector<HTMLElement>('.lb-close')?.focus();
  }

  function closeLightbox() {
    lbEl?.classList.remove('open');
    document.body.classList.remove('lb-locked');
  }

  function onKey(e: KeyboardEvent) {
    if (!lbEl?.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    else if (e.key === 'ArrowRight') step(1);
    else if (e.key === 'ArrowLeft') step(-1);
  }

  function initLightbox() {
    const body = document.querySelector<HTMLElement>('.project .body');
    if (!body) return;

    // Every body image is zoomable, in document order, except the hero and
    // except an image whose wrapping link points at something that is not an
    // image — a PDF drawing, a repo, another page. Those keep their link; the
    // lightbox only takes the click when the anchor points back at the image
    // itself, which is the gallery/grid pattern.
    const isImageHref = (a: HTMLAnchorElement) =>
      /\.(png|jpe?g|gif|webp|avif|svg)$/i.test(new URL(a.href, location.href).pathname);

    const imgs = Array.from(body.querySelectorAll<HTMLImageElement>('img')).filter((img) => {
      if (img.closest('.hero')) return false;
      const a = img.closest('a');
      return !a || isImageHref(a);
    });
    if (!imgs.length) return;

    lbItems = imgs.map((img) => ({ src: img.currentSrc || img.src, caption: captionFor(img) }));

    imgs.forEach((img, i) => {
      if (img.dataset.lbBound) return;
      img.dataset.lbBound = '1';
      img.classList.add('zoomable');
      const target: HTMLElement = img.closest('a') ?? img;
      target.addEventListener('click', (e) => {
        const me = e as MouseEvent;
        if (me.metaKey || me.ctrlKey || me.shiftKey || me.button !== 0) return;
        e.preventDefault();
        openLightbox(i);
      });
    });
  }

  function initAll() {
    interleaveGallery();
    initLightbox();
  }

  initAll();
  document.addEventListener('keydown', onKey);
  document.addEventListener('astro:after-swap', () => {
    lbEl?.remove();
    lbEl = null;
    closeLightbox();
    initAll();
  });
</script>

<style>
  .project {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  .back {
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-decoration: none;
    color: var(--ink-mute);
    display: inline-block;
    margin-bottom: 1rem;
  }
  .back:hover { color: var(--accent); }
  .one-liner {
    font-size: 1rem;
    color: var(--ink-soft);
    margin: 0.25rem 0 1rem;
    line-height: 1.5;
  }
  .meta-grid {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.5rem 1.5rem;
    margin: 1rem 0;
    font-size: 0.9375rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 0.75rem 0;
  }
  .meta-grid dt {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding-top: 0.2rem;
  }
  .meta-grid dd {
    margin: 0;
    color: var(--ink);
  }
  .hero {
    margin: 1rem 0 1.5rem;
  }
  .hero img {
    width: 100%;
    border-radius: 2px;
  }
  .body-with-toc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: 3rem;
  }
  .body { min-width: 0; }
  .toc-sidebar {
    align-self: stretch;
  }
  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  .body :global(ul),
  .body :global(ol) {
    padding-left: 1.25rem;
  }
  .body :global(li) {
    margin-bottom: 0.25rem;
  }
  .body :global(h2) {
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
    margin-top: 1.5rem;
  }
  .body :global(blockquote) {
    border-left: 3px solid var(--accent);
    margin: 1rem 0;
    padding-left: 1rem;
    color: var(--ink-soft);
    font-style: italic;
  }
  .body :global(hr) {
    margin: 1.5rem 0;
  }
  .body :global(figure:not(.hero):not(.section-images)) {
    margin: 1.25rem 0;
  }
  .body :global(figcaption) {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-mute);
    text-align: center;
    margin-top: 0.4rem;
    line-height: 1.4;
  }
  .body :global(.section-images) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin: 1.25rem 0;
    max-width: none;
  }
  .body :global(.section-images.single) {
    grid-template-columns: 1fr;
  }
  .body :global(.section-images.remainder) {
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
    border-top: 1px solid var(--rule);
    padding-top: 1.25rem;
    margin-top: 1.5rem;
  }
  .body :global(.section-images img) {
    width: 100%;
    height: auto;
    object-fit: contain;
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    transition: opacity 0.2s ease;
  }
  .body :global(.section-images a:hover img) {
    opacity: 0.85;
  }
  /* highlighted interactive-companion callout (used in body markdown) */
  .body :global(.sim-callout) {
    display: block;
    text-decoration: none;
    border: 1px solid var(--accent);
    border-left-width: 4px;
    border-radius: 4px;
    background: var(--accent-soft);
    padding: 1rem 1.25rem;
    margin: 1.75rem 0;
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .body :global(.sim-callout:hover) {
    background: rgba(30, 41, 59, 0.1);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px -10px rgba(30, 41, 59, 0.5);
  }
  .body :global(.sim-callout-eyebrow) {
    display: block;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .body :global(.sim-callout-title) {
    display: block;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.35rem;
  }
  .body :global(.sim-callout-desc) {
    display: block;
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.55;
    margin-bottom: 0.65rem;
  }
  .body :global(.sim-callout-cta) {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
  }
  /* photo grid — paste one <img> per photo inside a
     <div class="photo-grid"> in the markdown body */
  .body :global(.photo-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: 0.5rem;
    margin: 1.25rem 0;
  }
  .body :global(.photo-grid.tight) {
    grid-template-columns: repeat(auto-fill, minmax(min(160px, 100%), 1fr));
  }
  .body :global(.photo-grid.wide) {
    grid-template-columns: repeat(auto-fill, minmax(min(360px, 100%), 1fr));
  }
  .body :global(.photo-grid img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    transition: opacity 0.2s ease;
  }
  .body :global(.photo-grid.natural img) {
    aspect-ratio: auto;
    height: auto;
    object-fit: contain;
  }
  .body :global(.photo-grid img:hover) {
    opacity: 0.85;
  }

  /* video figures — 16:9 responsive embed without inline styles */
  .body :global(.video) {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
  }
  .body :global(.video iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* self-hosted silent clips — sized by their own aspect, not forced to 16:9.
     The cap goes on the video, not the figure, so the clip centres in the
     column while the figcaption still gets the full width to wrap in. */
  .body :global(.clip video) {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
    background: var(--bg-elev);
    border: 1px solid var(--rule);
  }
  .body :global(.clip.portrait video) {
    max-width: 320px;
  }
  .body :global(.clip.small video) {
    max-width: 420px;
  }

  /* press coverage */
  .press h2 {
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
    margin-top: 1.5rem;
  }
  .press ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .press li {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1rem;
    align-items: baseline;
    border-bottom: 1px solid var(--rule);
    padding: 0.75rem 0;
  }
  .press-outlet {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .press-lang {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-mute);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0 0.35rem;
  }
  .press-body a {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .press-body a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .press-body a::after {
    content: ' ↗';
    color: var(--ink-mute);
    border: 0;
  }
  .press-date {
    display: block;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-mute);
    margin-top: 0.3rem;
  }

  .links h2 {
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
    margin-top: 1.5rem;
  }
  .related-pub {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background: var(--bg-elev);
    border-left: 3px solid var(--accent);
  }
  .rp-label {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .rp-title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0.5rem 0;
  }
  .rp-title a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .rp-title a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .rp-meta {
    color: var(--ink-mute);
    font-size: 0.875rem;
    margin: 0.5rem 0 0.75rem;
    line-height: 1.5;
  }
  .rp-link {
    font-family: var(--mono);
    font-size: 0.8125rem;
    margin: 0;
  }
  .rp-link a {
    color: var(--accent);
    text-decoration: none;
  }
  .links ul {
    list-style: none;
    padding: 0;
    font-family: var(--mono);
    font-size: 0.9375rem;
  }
  .links li {
    border-bottom: 1px solid var(--rule);
    padding: 0.75rem 0;
  }
  .links a {
    text-decoration: none;
    color: var(--ink);
  }
  .links a:hover { color: var(--accent); }
  .links a::after {
    content: ' ↗';
    color: var(--ink-mute);
  }

  @media (max-width: 960px) {
    .body-with-toc {
      grid-template-columns: minmax(0, 1fr);
    }
    .toc-sidebar {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .meta-grid {
      grid-template-columns: 1fr;
      gap: 0.1rem 0;
    }
    .meta-grid dt { padding-top: 0.75rem; }
    .press li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }

  :global(article[data-slug="holonomic-odometry-testbed"] .body figure:not(.hero):not(.section-images)) {
    max-width: 65%;
    margin-left: auto;
